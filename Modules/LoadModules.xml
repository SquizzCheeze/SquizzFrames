<Ui xmlns="http://www.blizzard.com/wow/ui/" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.blizzard.com/wow/ui/
../FrameXML/UI.xsd">
    <!-- First: the Edit Mode grid bridge, whose SnapTarget/SnapDelta helpers
         every mover below calls (at runtime, but defined up front). -->
    <Script file="Grid/SnapGrid.lua"/>
    <Include file="PartyFrames/UnitButton.xml"/>
    <Script file="PartyFrames/UnitButton.lua"/>
    <Script file="PartyFrames/PartyFrames.lua"/>
    <!-- The Layout page's mock grid. After PartyFrames.lua: it reads
         PartyFrames.shared at load. -->
    <!-- Per-button health/power/role/status updates. Reads PartyFrames.shared
         at load, publishes PartyFrames.buttons for the forwarders. -->
    <Script file="PartyFrames/PartyButtons.lua"/>
    <Script file="PartyFrames/PartyPreview.lua"/>
    <!-- Out-of-range fading. Same: reads PartyFrames.shared at load, and
         publishes PartyFrames.range for the forwarders in PartyFrames.lua. -->
    <Script file="PartyFrames/PartyRange.lua"/>
    <!-- The Layout options page. Named for the page rather than the module,
         since "Layout" is what it is called in the nav. -->
    <Script file="PartyFrames/LayoutPanel.lua"/>
    <Include file="PetFrames/PetButton.xml"/>
    <Script file="PetFrames/PetButton.lua"/>
    <Script file="PetFrames/PetFrames.lua"/>
    <!-- Options page for the above. Loaded after it, and after
         Options/Widgets.lua from the .toc, since it is a shell over both. -->
    <Script file="PetFrames/PetFramesPanel.lua"/>
    <!-- Standalone single-unit frames (player/target/ToT/focus/focustarget).
         Loaded before ClickCasting so CollectButtons can see them on the very
         first ApplyToAll rather than waiting for a later re-apply. -->
    <Include file="UnitFrames/UnitFrameButton.xml"/>
    <!-- Before UnitFrames.lua: it reads SquizzFrames.UnitFrameCastBar at
         runtime rather than load time, so order is not strictly required, but
         keeping the dependency pointing one way stays easier to reason about. -->
    <Script file="UnitFrames/CastBar.lua"/>
    <Script file="UnitFrames/Portrait.lua"/>
    <!-- After Indicators loads AuraEngine? No: Auras.lua reads
         SquizzFrames.AuraEngine at RUNTIME, never at load, so order is free.
         Kept beside its siblings for readability. -->
    <Script file="UnitFrames/Auras.lua"/>
    <Script file="UnitFrames/Icons.lua"/>
    <Script file="UnitFrames/Absorbs.lua"/>
    <Script file="UnitFrames/Highlights.lua"/>
    <Script file="UnitFrames/Dispels.lua"/>
    <!-- Standalone player resource bar. Reads its settings out of
         profile.unitFrames but is NOT gated on that module being enabled.
         See its header. (No prose double-dash in here: it is illegal inside
         an XML comment and kills the whole file, which then surfaces as a
         misleading Lua error about an inherited node.) -->
    <Script file="UnitFrames/ResourceBar.lua"/>
    <!-- Options-page mock. Reads UnitFrames.FormatToken/ResolveHealthColor at
         runtime so the preview cannot drift from what the real frames draw. -->
    <Script file="UnitFrames/Preview.lua"/>
    <Script file="UnitFrames/UnitFrames.lua"/>
    <!-- After UnitFrames.lua: finds the arena frames through its
         FindButtonByUnit and hooks its public ApplyLayout. -->
    <Script file="UnitFrames/ArenaPrep.lua"/>
    <!-- Shell over the module + Options/Widgets.lua (already loaded by the
         .toc at this point), same arrangement as NicknamesPanel. -->
    <Script file="UnitFrames/UnitFramesPanel.lua"/>
    <!-- The page's Resources section. Right after it: reads Panel.shared at
         load and publishes Panel.SecResource for its forwarder. -->
    <Script file="UnitFrames/UnitFramesResourcePanel.lua"/>
    <Script file="ClickCasting/ClickCasting.lua"/>
    <Script file="ClickCasting/ClickCastingPanel.lua"/>
    <Script file="Indicators/Indicators.lua"/>
    <Script file="Indicators/IndicatorDefaults.lua"/>
    <Script file="Indicators/AuraEngine.lua"/>
    <Script file="Indicators/AuraEngineIndicators.lua"/>
    <!-- Dispels + Dispel Icons. Right after AuraEngineIndicators.lua: it reads
         AEI.shared at load and publishes AEI.CreateDispelsIndicator and the
         health-bar helpers before anything builds an indicator. -->
    <Script file="Indicators/AuraEngineDispels.lua"/>
    <!-- Custom color + bar indicators. After AuraEngineDispels.lua, whose
         health-bar helpers it calls at runtime. -->
    <Script file="Indicators/AuraEngineCustom.lua"/>
    <Script file="Indicators/BuiltIn_Update.lua"/>
    <Script file="Indicators/Custom_Dispatch.lua"/>
    <!-- Widget building blocks. Right before IndicatorWidgets.lua, which
         imports them from SquizzFrames.IndicatorWidgetsBase at load. -->
    <Script file="Indicators/IndicatorWidgetsBase.lua"/>
    <!-- Spell-list settings. After the building blocks it imports, before
         IndicatorWidgets.lua, which imports it at load. -->
    <Script file="Indicators/IndicatorWidgetsSpells.lua"/>
    <!-- Dispels settings. Same arrangement as the spell lists above. -->
    <Script file="Indicators/IndicatorWidgetsDispels.lua"/>
    <Script file="Indicators/IndicatorWidgets.lua"/>
    <Script file="Indicators/IndicatorsPanel.lua"/>
    <!-- After IndicatorsPanel: consumes its CreateMockUnitButton factory. -->
    <Script file="Indicators/GroupPreview.lua"/>
    <!-- After Indicators: refreshes names through nameText's _sfNameUpdater. -->
    <Script file="Nicknames/Nicknames.lua"/>
    <!-- After Nicknames + Options/Widgets: the panel is a shell over both. -->
    <Script file="Nicknames/NicknamesPanel.lua"/>
    <!-- Release notes / first-run greeting. Must load with the other modules
         so it can read SquizzFramesDB BEFORE Core's OnInitialize creates the
         profile tree. See hadSavedVariables in the file. -->
    <Script file="Welcome/Welcome.lua"/>
    <!-- Tank Tracker. Reads SquizzFrames.UnitFrameAuras (its anchor vocabulary)
         and SquizzFrames.AuraEngine at RUNTIME, never at load, so order is
         free; kept last simply because it is the newest module. -->
    <Script file="TankTracker/TankTracker.lua"/>
    <Script file="TankTracker/TankTrackerPreview.lua"/>
    <Script file="TankTracker/TankTrackerPanel.lua"/>
</Ui>
